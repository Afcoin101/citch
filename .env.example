# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Backend server configurations
PORT=3000
STRIPE_SECRET_KEY=sk_test_51...your_stripe_secret_key_here...
LIVE_BACKEND_URL=http://10.0.2.2:3000

# PayPal Client Configuration for Customer Payments and Chef Payouts
PAYPAL_CLIENT_ID=sb-test-client-id
PAYPAL_ENVIRONMENT=sandbox

# Android Release Signing configurations (Optional, only needed for Google Play release)
# KEYSTORE_PATH=my-upload-key.jks
# STORE_PASSWORD=your_store_password
# KEY_ALIAS=upload
# KEY_PASSWORD=your_key_password
